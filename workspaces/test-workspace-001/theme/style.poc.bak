/* ========================================================
   BIZFIRE THEME: Trades Modern
   Pure Theme Stylesheet (Zero Editor Bloat)
   ======================================================== */

:root {
  --color-primary: #172033;
  --color-primary-hover: #222e47;
  --color-accent: #0284c7;
  --color-accent-light: #e0f2fe;
  --color-star: #f59e0b;
  --color-text-main: #172033;
  --color-text-muted: #5b6472;
  --color-bg-light: #f7f7f5;
  --color-bg-alt: #f8fafc;
  --color-border: #e2e8f0;
  --color-white: #ffffff;
  --font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 24px;
}

*, *::before, *::after {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  padding: 0;
  font-family: var(--font-family);
  color: var(--color-text-main);
  background-color: #ffffff;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

/* --------------------------------------------------------
   Hero Split Component (.hero-section)
   -------------------------------------------------------- */
.hero-section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 48px 24px;
}

.hero-section__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  background-color: var(--color-bg-light);
  padding: 56px;
  border-radius: var(--radius-xl);
}

.hero-section__eyebrow {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: #71717a;
  text-transform: uppercase;
  margin: 0 0 14px;
}

.hero-section h1 {
  font-size: clamp(32px, 3.8vw, 56px);
  line-height: 1.05;
  letter-spacing: -0.035em;
  color: var(--color-primary);
  margin: 0 0 16px;
}

.hero-section__subtitle {
  font-size: 18px;
  line-height: 1.6;
  color: var(--color-text-muted);
  margin: 0 0 28px;
}

.hero-section__actions {
  display: flex;
  gap: 14px;
  align-items: center;
}

.hero-section__image {
  width: 100%;
  height: 380px;
  object-fit: cover;
  border-radius: var(--radius-lg);
  box-shadow: 0 12px 30px -10px rgba(0,0,0,0.1);
}

@media (max-width: 860px) {
  .hero-section__inner {
    grid-template-columns: 1fr;
    padding: 32px 24px;
    gap: 32px;
  }
  .hero-section__image {
    height: 280px;
  }
}

/* --------------------------------------------------------
   Benefits Grid Component (.benefits-section)
   -------------------------------------------------------- */
.benefits-section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 56px 24px;
}

.benefits-section__heading {
  max-width: 640px;
  margin-bottom: 36px;
}

.benefits-section__eyebrow {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: var(--color-accent);
  text-transform: uppercase;
  margin: 0 0 10px;
}

.benefits-section h2 {
  font-size: clamp(28px, 3vw, 40px);
  letter-spacing: -0.03em;
  color: var(--color-primary);
  margin: 0 0 12px;
}

.benefits-section__subtitle {
  font-size: 16px;
  color: var(--color-text-muted);
  margin: 0;
  line-height: 1.6;
}

.benefits-section__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.benefit-card {
  background: var(--color-bg-light);
  padding: 30px 26px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.benefit-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 20px -5px rgba(0,0,0,0.06);
}

.benefit-card__number {
  font-size: 12px;
  font-weight: 800;
  color: #94a3b8;
  letter-spacing: 0.1em;
  margin-bottom: 16px;
}

.benefit-card h3 {
  font-size: 19px;
  margin: 0 0 8px;
  color: var(--color-primary);
}

.benefit-card p {
  font-size: 14px;
  color: var(--color-text-muted);
  margin: 0;
  line-height: 1.5;
}

@media (max-width: 860px) {
  .benefits-section__grid {
    grid-template-columns: 1fr;
  }
}

/* --------------------------------------------------------
   Testimonials Grid Component (.testimonials-section)
   -------------------------------------------------------- */
.testimonials-section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 56px 24px;
}

.testimonials-section__heading {
  max-width: 640px;
  margin-bottom: 32px;
}

.testimonials-section__eyebrow {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: var(--color-accent);
  text-transform: uppercase;
  margin: 0 0 10px;
}

.testimonials-section h2 {
  font-size: clamp(28px, 3vw, 40px);
  letter-spacing: -0.03em;
  color: var(--color-primary);
  margin: 0 0 10px;
}

.testimonials-section__subtitle {
  font-size: 16px;
  color: var(--color-text-muted);
  margin: 0;
  line-height: 1.6;
}

.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 24px;
}

.testimonial-card {
  background: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 20px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.testimonial-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 24px -6px rgba(0,0,0,0.06);
}

.testimonial-card__rating {
  color: var(--color-star);
  font-size: 15px;
  letter-spacing: 2px;
}

.testimonial-card__quote {
  margin: 0;
  font-size: 15px;
  line-height: 1.65;
  color: #334155;
  font-style: italic;
}

.testimonial-card__footer {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid #eef2f6;
  margin-top: auto;
}

.testimonial-card__badge {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-accent-light);
  color: var(--color-accent);
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 800;
}

.testimonial-card__author {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: var(--color-primary);
}

.testimonial-card__role {
  display: block;
  font-size: 12px;
  color: var(--color-text-muted);
}

@media (max-width: 900px) {
  .testimonials-grid {
    grid-template-columns: 1fr;
  }
}

/* --------------------------------------------------------
   Call to Action Component (.cta-section)
   -------------------------------------------------------- */
.cta-section {
  max-width: 1100px;
  margin: 40px auto;
  padding: 0 24px;
}

.cta-section__box {
  background: var(--color-primary);
  color: #ffffff;
  padding: 50px 48px;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}

.cta-section h2 {
  font-size: clamp(26px, 2.8vw, 38px);
  letter-spacing: -0.03em;
  margin: 0 0 10px;
  color: #ffffff;
}

.cta-section p {
  color: #cbd5e1;
  margin: 0;
  font-size: 16px;
  max-width: 550px;
  line-height: 1.6;
}

.cta-section__button {
  display: inline-block;
  background: #ffffff;
  color: var(--color-primary);
  font-weight: 800;
  font-size: 14px;
  padding: 14px 24px;
  border-radius: var(--radius-sm);
  white-space: nowrap;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.cta-section__button:hover {
  opacity: 0.95;
  transform: translateY(-1px);
}

@media (max-width: 760px) {
  .cta-section__box {
    flex-direction: column;
    align-items: flex-start;
    padding: 36px 24px;
  }
}

/* --------------------------------------------------------
   FAQ Accordion Component (.faq-section)
   -------------------------------------------------------- */
.faq-section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 56px 24px;
}

.faq-section__heading {
  max-width: 640px;
  margin-bottom: 32px;
}

.faq-section__eyebrow {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: var(--color-accent);
  text-transform: uppercase;
  margin: 0 0 10px;
}

.faq-section h2 {
  font-size: clamp(28px, 3vw, 40px);
  letter-spacing: -0.03em;
  color: var(--color-primary);
  margin: 0 0 10px;
}

.faq-section__subtitle {
  font-size: 16px;
  color: var(--color-text-muted);
  margin: 0;
  line-height: 1.6;
}

.faq-list {
  display: grid;
  gap: 12px;
  max-width: 800px;
}

.faq-item {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-alt);
  padding: 18px 24px;
}

.faq-item summary {
  font-weight: 700;
  font-size: 16px;
  color: var(--color-primary);
  cursor: pointer;
  outline: none;
}

.faq-item p {
  margin: 12px 0 0;
  font-size: 14px;
  color: var(--color-text-muted);
  line-height: 1.6;
}

/* Global Button Tokens */
.btn-primary {
  display: inline-block;
  background: var(--color-primary);
  color: #ffffff;
  padding: 13px 22px;
  border-radius: var(--radius-sm);
  font-weight: 700;
  font-size: 14px;
  transition: opacity 0.15s ease;
}

.btn-primary:hover {
  opacity: 0.9;
}
