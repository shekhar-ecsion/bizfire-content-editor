# Bizfire Content Editor Environment Configuration
# Copy this file to .env.local for local development

# Application URLs
NEXT_PUBLIC_URL="http://localhost:3002/"
NEXTAUTH_URL=http://localhost:3002/
NEXTAUTH_SECRET=

# Backend & Gateway APIs
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_AZURE_URL=
NEXT_PUBLIC_API_BIZFIRE=
NEXT_PUBLIC_NODE_URL=

# Multi-Tenancy & Application Context Headers
NEXT_PUBLIC_APP_GUID=
NEXT_PUBLIC_APP_NAME="Bizfire Content Editor"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_VENUE_GUID=
NEXT_PUBLIC_SUB_VENUE_GUID=
NEXT_PUBLIC_FRANCHISE_GUID=
NEXT_PUBLIC_WORKSPACE_GUID=
NEXT_PUBLIC_UUID_KEY=

# WordPress Integration (Optional for local testing)
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
